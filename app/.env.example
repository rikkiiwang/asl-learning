# Browser client (safe to expose — anon key is row-level-security gated)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Seed script ONLY (server-side; NEVER expose in the browser bundle)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional override; defaults to ../model/artifacts/manifest/manifest.json
MANIFEST_PATH=
