# Browser client (safe to expose — anon key is row-level-security gated)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Dev/eval tooling (PRD Req 7). Leave UNSET for the graded build — that omits
# the pretrained-baseline model and the comparison switcher. Set to true only
# for local dev/eval (in .env.local, which is gitignored).
VITE_DEV_TOOLS=

# Seed script ONLY (server-side; NEVER expose in the browser bundle)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional override; defaults to ../model/artifacts/manifest/manifest.json
MANIFEST_PATH=
